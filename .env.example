# Tùy chọn: Địa chỉ công khai của ứng dụng khi triển khai (mặc định http://localhost:3000)
# APP_URL=http://localhost:3000

# Cấu hình SMTP để gửi email thực tế (ví dụ Gmail sử dụng Mật khẩu ứng dụng - App Password 16 ký tự)
# Nếu chưa cấu hình SMTP, hệ thống sẽ tự động hiển thị Mã OTP 6 số & Liên kết xác nhận trực tiếp trên giao diện (Dev Preview).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=TaskMaster <no-reply@example.com>
